# Use a separate file from the Go .env; Node does not need database credentials.
VOEX_COLLAB_HOST=127.0.0.1
VOEX_COLLAB_PORT=8091
VOEX_COLLAB_API_URL=http://127.0.0.1:8090
VOEX_COLLAB_SECRET_FILE=/home/server/.secrets/collab-key
# Exact scheme + host + optional port; no paths or wildcard.
# Set to the actual browser origins. This example matches the Vite development port.
VOEX_COLLAB_ORIGINS=http://192.140.173.58:3500
NODE_ENV=production
