MYSQL_HOST=192.140.173.58
MYSQL_PORT=3306
MYSQL_USER=voex
MYSQL_PASSWORD="replace-with-your-password"
MYSQL_DATABASE=file_server
VOEX_ADDR=127.0.0.1:8090
JWT_SECRET_FILE=/home/server/.secrets/jwt-key
# Host-persistent local storage; historical R2 objects are not migrated.
VOEX_STORAGE_ROOT=/home/static
VOEX_HTTP_READ_TIMEOUT=2m


# Stable signing key for the two fixed document share links. Preserve across deployments.
SHARE_SECRET_FILE=/home/server/.secrets/share-key

# Real-time document collaboration (off until the explicit SQL migration is applied).
VOEX_COLLAB_ENABLED=false
VOEX_COLLAB_URL=http://127.0.0.1:8091
VOEX_COLLAB_SECRET_FILE=/home/server/.secrets/collab-key
VOEX_COLLAB_WS_URL=/api/collab/ws
