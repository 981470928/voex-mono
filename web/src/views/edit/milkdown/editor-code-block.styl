.milkdown-editor .milkdown-editor__content .milkdown-editor__code-block
  position relative
  box-sizing border-box
  width 100%
  max-width 100%
  margin 16px 0
  overflow hidden
  border 1px solid var(--editor-border)
  border-radius 8px
  background var(--editor-panel)
  color var(--editor-text)
  line-height 1.6
  overflow-wrap normal

  &.selected
    outline 2px solid var(--editor-accent)
    outline-offset 1px

  .tools
    display flex
    align-items center
    justify-content space-between
    gap 8px
    min-height 42px
    padding 5px 8px
    border-bottom 1px solid var(--editor-border)
    font-family inherit
    font-size 12px

  .language-button, .language-picker
    display none

  .milkdown-editor__code-language
    box-sizing border-box
    min-width 0
    max-width min(55%, 220px)
    min-height 30px
    padding 4px 24px 4px 8px
    border 1px solid var(--editor-border)
    border-radius 6px
    background var(--editor-panel)
    color var(--editor-secondary)
    font inherit
    cursor pointer

    &:hover:not(:disabled)
      background var(--editor-hover)
      color var(--editor-text)

    &:disabled
      opacity 1
      cursor default
      border-color transparent
      appearance none

  .tools-button-group
    display flex
    align-items center
    gap 4px
    flex-shrink 0

  button
    display inline-flex
    align-items center
    justify-content center
    gap 6px
    min-width 30px
    min-height 30px
    padding 4px 8px
    border 1px solid transparent
    border-radius 6px
    color var(--editor-secondary)
    background transparent
    font-family inherit
    font-size 12px
    line-height 1.4
    white-space nowrap
    cursor pointer

    &:hover:not(:disabled)
      background var(--editor-hover)
      color var(--editor-text)

    &:active:not(:disabled)
      background var(--editor-selected)

    &:disabled
      opacity .5
      cursor default

  button:focus-visible, select:focus-visible, .cm-textfield:focus-visible
    outline 2px solid var(--editor-accent)
    outline-offset 1px

  .milkdown-icon, svg
    display inline-flex
    width 16px
    height 16px
    flex-shrink 0
    fill currentColor

  .cm-editor
    min-height 64px
    background transparent
    color var(--editor-text)
    outline none

    &.cm-focused
      outline none

  .cm-scroller
    overflow-x auto
    font-family 'Cascadia Code', Consolas, monospace
    font-size 13px
    line-height 1.65

  .cm-content
    padding 10px 0
    caret-color var(--editor-accent)

  .cm-line
    padding 0 12px 0 8px

  .cm-cursor, .cm-dropCursor
    border-left-color var(--editor-accent)

  .cm-selectionBackground, .cm-focused .cm-selectionBackground
    background var(--editor-selected)

  .cm-activeLine, .cm-activeLineGutter
    background var(--editor-hover)

  .cm-gutters
    border-right 1px solid var(--editor-border)
    background var(--editor-panel)
    color var(--editor-muted)

  .cm-gutterElement
    padding 0 5px

  .cm-foldGutter .cm-gutterElement
    cursor pointer

  .cm-foldPlaceholder
    padding 0 4px
    border 1px solid var(--editor-border)
    border-radius 4px
    color var(--editor-secondary)
    background var(--editor-hover)
    cursor pointer

  .cm-matchingBracket
    background var(--editor-selected)
    outline 1px solid var(--editor-accent)

  .cm-searchMatch
    background var(--editor-hover)
    outline 1px solid var(--editor-border)

  .cm-searchMatch-selected
    background var(--editor-selected)
    outline-color var(--editor-accent)

  .cm-panels
    border-color var(--editor-border)
    background var(--editor-panel)
    color var(--editor-text)

  .cm-search
    display flex
    flex-wrap wrap
    align-items center
    gap 6px
    padding 8px
    font-family inherit
    font-size 12px

    .cm-textfield
      box-sizing border-box
      flex 1 1 140px
      min-width 90px
      max-width 220px
      min-height 30px
      margin 0
      padding 4px 8px
      border 1px solid var(--editor-border)
      border-radius 6px
      background var(--editor-bg)
      color var(--editor-text)
      font inherit

    .cm-button, .milkdown-editor__code-clear-search
      margin 0
      border-color var(--editor-border)

    label
      display inline-flex
      align-items center
      gap 4px
      margin 0
      white-space nowrap

    input[type='checkbox']
      margin 0
      accent-color var(--editor-accent)

    br
      width 100%

    button[name='close']
      position static
      margin-left auto
      font-size 18px

  .milkdown-code-block-placeholder
    margin 0
    padding 12px 16px
    border 0
    border-radius 0
    background transparent
    font-size 13px

  &[data-readonly='true'] .cm-activeLine
    background transparent

@media (max-width: 600px)
  .milkdown-editor .milkdown-editor__content .milkdown-editor__code-block
    .tools
      gap 4px

    .cm-search .cm-textfield
      flex-basis 100%
      max-width none

    .cm-scroller
      font-size 12px
