// ============================================
// Voex 主题变量体系
// 基于 CSS 自定义属性，通过 [data-theme] 切换
// ============================================


// --- 暗色主题 ---
[data-theme='dark']
  // 品牌色
  --voex-primary: #4da6ff
  --voex-primary-light: #80c0ff
  --voex-primary-dark: #1e90ff
  --voex-secondary: #ff7b6b

  --header-bg: #0b0b0bcc;
  --header-border: #ffffff14;

  --color-bg-primary: #08090a;
  --color-bg-secondary: #1c1c1f;
  --color-bg-tertiary: #232326;
  --color-bg-quaternary: #28282c;
  --color-bg-marketing: #010102;
  --color-bg-translucent: #ffffff0d;
  --color-bg-quinary: #282828;
  --color-bg-panel: #0f1011;

  --color-border-primary: #23252a;
  --color-border-secondary: #34343a;
  --color-border-tertiary: #3e3e44;
  --color-border-translucent: #ffffff0d;
  --color-border-translucent-strong: #ffffff14;

  --color-text-primary: #f7f8f8;
  --color-text-secondary: #d0d6e0;
  --color-text-tertiary: #8a8f98;
  --color-text-quaternary: #62666d;

  --color-link-primary: #828fff;
  --color-link-hover: #fff;

  --color-brand-bg: #5e6ad2;
  --color-brand-text: #fff;

  --color-button-invert-bg: #e5e5e6;
  --color-button-invert-bg-hover: #fff;

  --color-selection-text: var(--color-white);
  --color-selection-bg: unquote('color-mix(in lch, var(--color-brand-bg), black 10%)');
  --color-selection-dim: unquote('color-mix(in lch, var(--color-brand-bg), transparent 80%)');
  
  --color-overlay-dim-rgb: 255, 255, 255;
  --color-overlay-primary: #000000d9;
  --color-alpha: 255;

  --shadow-low: 0px 2px 4px #0000001a;
  --shadow-medium: 0px 4px 24px #0003;
  --shadow-high: 0px 7px 32px #00000059;
  --shadow-stack-low:
    0px 8px 2px 0px #0000, 0px 5px 2px 0px #00000003, 0px 3px 2px 0px #0000000a,
    0px 1px 1px 0px #00000012, 0px 0px 1px 0px #00000014;

  --icon-grayscale-image-filter: grayscale(100%) brightness(400%);
  --color-bg-level-0: #08090a;
  --color-bg-level-1: #0f1011;
  --color-bg-level-2: #141516;
  --color-bg-level-3: #191a1b;
  --color-bg-tint: #141516;

  --color-line-primary: #37393a;
  --color-line-secondary: #202122;
  --color-line-tertiary: #18191a;
  --color-line-quaternary: #141515;
  --color-line-tint: #141516;

  --color-fg-primary: #f7f8f8;
  --color-fg-secondary: #d0d6e0;
  --color-fg-tertiary: #8a8f98;
  --color-fg-quaternary: #62666d;
  
  --color-accent: #7170ff;
  --color-accent-hover: #828fff;
  --color-accent-tint: #18182f;


// --- 明亮主题 ---
[data-theme='light']
  --voex-primary: #1e90ff
  --voex-primary-light: #4da6ff
  --voex-primary-dark: #0066cc
  --voex-secondary: #d94b3d

  --header-bg: #ffffffcc;
  --header-border: #00000014;

  --color-bg-primary: #ffffff;
  --color-bg-secondary: #f5f5f7;
  --color-bg-tertiary: #ededf0;
  --color-bg-quaternary: #e5e5e9;
  --color-bg-marketing: #fafafa;
  --color-bg-translucent: #0000000d;
  --color-bg-quinary: #dedee3;
  --color-bg-panel: #f8f8fa;

  --color-border-primary: #dedee3;
  --color-border-secondary: #cfcfd6;
  --color-border-tertiary: #bcbcc5;
  --color-border-translucent: #0000000d;
  --color-border-translucent-strong: #00000014;

  --color-text-primary: #1a1a1a;
  --color-text-secondary: #50505c;
  --color-text-tertiary: #70707d;
  --color-text-quaternary: #8a8a96;

  --color-link-primary: #514fc9;
  --color-link-hover: #3533a3;

  --color-brand-bg: #5e6ad2;
  --color-brand-text: #fff;

  --color-button-invert-bg: #232326;
  --color-button-invert-bg-hover: #08090a;

  --color-selection-text: var(--color-white);
  --color-selection-bg: unquote('color-mix(in lch, var(--color-brand-bg), black 10%)');
  --color-selection-dim: unquote('color-mix(in lch, var(--color-brand-bg), transparent 80%)');

  --color-overlay-dim-rgb: 0, 0, 0;
  --color-overlay-primary: #00000066;
  --color-alpha: 0;

  --shadow-low: 0px 2px 4px #0000000d;
  --shadow-medium: 0px 4px 24px #00000014;
  --shadow-high: 0px 7px 32px #00000024;
  --shadow-stack-low:
    0px 8px 2px 0px #0000, 0px 5px 2px 0px #00000003, 0px 3px 2px 0px #0000000a,
    0px 1px 1px 0px #00000012, 0px 0px 1px 0px #00000014;

  --icon-grayscale-image-filter: grayscale(100%) brightness(0%);
  --color-bg-level-0: #ffffff;
  --color-bg-level-1: #fafafa;
  --color-bg-level-2: #f5f5f7;
  --color-bg-level-3: #ededf0;
  --color-bg-tint: #f5f5f7;

  --color-line-primary: #cfcfd6;
  --color-line-secondary: #dedee3;
  --color-line-tertiary: #ededf0;
  --color-line-quaternary: #f5f5f7;
  --color-line-tint: #ededf0;

  --color-fg-primary: #1a1a1a;
  --color-fg-secondary: #50505c;
  --color-fg-tertiary: #70707d;
  --color-fg-quaternary: #8a8a96;

  --color-accent: #5e5cdb;
  --color-accent-hover: #514fc9;
  --color-accent-tint: #eeeeff;
