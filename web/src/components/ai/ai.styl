.ai-button
  min-height 34px
  padding 6px 12px
  border 1px solid var(--color-border-secondary)
  border-radius 6px
  background var(--color-bg-secondary)
  color var(--color-text-primary)
  font inherit
  font-size 13px
  cursor pointer
  &:hover:not(:disabled)
    background var(--color-bg-tertiary)
  &:focus-visible
    outline 2px solid var(--color-accent)
    outline-offset 2px
  &:active:not(:disabled)
    transform translateY(1px)
  &:disabled
    opacity .5
    cursor not-allowed
  &--primary
    background var(--color-brand-bg)
    color var(--color-brand-text)
    &:hover:not(:disabled)
      background var(--color-accent)

.ai-field
  display flex
  flex-direction column
  gap 6px
  min-width 0
  font-size 13px
  input, select, textarea
    box-sizing border-box
    min-width 0
    width 100%
    padding 9px 10px
    border 1px solid var(--color-border-secondary)
    border-radius 6px
    background var(--color-bg-panel)
    color var(--color-text-primary)
    font inherit
    &:focus-visible
      outline 2px solid var(--color-accent)
      outline-offset 1px
    &[aria-invalid='true']
      border-color var(--color-red)
  textarea
    resize none
  small
    color var(--color-text-tertiary)
    line-height 1.5

.ai-error
  color var(--color-red)
  font-size 13px
  line-height 1.6
  overflow-wrap anywhere

.ai-actions
  display flex
  align-items center
  gap 8px
  justify-content flex-end
